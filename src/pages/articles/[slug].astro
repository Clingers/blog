---
import Layout from '../../layouts/Layout.astro';
import { links } from '../../lib/links';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, excerpt, category, author, readTime, date } = article.data;
---

<Layout title={`${title} — Wilfred's Blog`} description={excerpt}>
  <div class="min-h-screen bg-white">

    <header class="border-b border-gray-100">
      <div class="max-w-3xl mx-auto px-6 pt-6 pb-4">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h1 class="text-lg font-bold text-gray-900">
              <a href={links.home} class="hover:text-gray-600 transition-colors">future/proof</a>
            </h1>
            <p class="text-xs text-gray-400 mt-0.5">stay relevant</p>
          </div>
          <nav class="flex items-center gap-5">
            <a href={links.about} class="nav-link">关于</a>
            <a href={links.archive} class="nav-link">归档</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-10">

      <a href={links.home} class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-8">
        ← 返回首页
      </a>

      <div class="flex items-center gap-3 mb-4">
        <span class="category-tag">{category}</span>
        <span class="text-gray-300">·</span>
        <span class="read-time">{readTime}</span>
        <span class="text-gray-300">·</span>
        <span class="read-time">{date.toISOString().slice(0, 10)}</span>
      </div>

      <h1 class="text-3xl font-bold text-gray-900 leading-tight mb-4">
        {title}
      </h1>

      <p class="text-lg text-gray-500 leading-relaxed mb-8 border-l-2 border-gray-200 pl-4 italic">
        {excerpt}
      </p>

      <!-- Markdown 渲染的正文 -->
      <div class="article-body text-gray-800 leading-loose text-base space-y-5 prose prose-gray max-w-none">
        <Content />
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100 flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-gray-900 flex items-center justify-center text-white font-bold text-sm">
          {author.charAt(0)}
        </div>
        <div>
          <div class="font-semibold text-gray-900 text-sm">{author}</div>
          <div class="text-xs text-gray-400">研究者 · 写作者</div>
        </div>
      </div>

    </main>

    <footer class="border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-6 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-4 text-xs text-gray-400">
            <a href={links.home} class="hover:text-gray-600 transition-colors">首页</a>
            <a href={links.about} class="hover:text-gray-600 transition-colors">关于</a>
            <a href={links.archive} class="hover:text-gray-600 transition-colors">归档</a>
          </div>
          <p class="text-xs text-gray-400">© 2026 Wilfred · 保留所有权利</p>
        </div>
      </div>
    </footer>

  </div>
</Layout>
