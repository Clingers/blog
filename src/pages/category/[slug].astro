---
import Layout from '../../layouts/Layout.astro';
import { links } from '../../lib/links';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // 分类 slug 映射：避免中文/特殊字符在 URL 中的问题
  const CATEGORY_SLUGS: Record<string, string> = {
    'AI & 工具': 'ai-tools',
    '写作策略': 'writing',
    '营销策略': 'marketing',
    '个人成长': 'growth',
  };
  const allArticles = await getCollection('articles');
  const categories = [...new Set(allArticles.map(a => a.data.category))];
  return categories.map(cat => ({
    params: { slug: CATEGORY_SLUGS[cat] || cat },
    props: { cat, allArticles },
  }));
}

const { cat, allArticles } = Astro.props;
const catArticles = allArticles
  .filter(a => a.data.category === cat)
  .sort((a, b) => b.data.date - a.data.date);
---

<Layout title={`${cat} — Wilfred's Blog`}>
  <div class="min-h-screen bg-white">

    <header class="border-b border-gray-100">
      <div class="max-w-3xl mx-auto px-6 pt-6 pb-4">
        <div class="flex items-center justify-between">
          <h1 class="text-lg font-bold text-gray-900">
            <a href={links.home} class="hover:text-gray-600 transition-colors">future/proof</a>
          </h1>
          <nav class="flex items-center gap-5">
            <a href={links.about} class="nav-link">关于</a>
            <a href={links.archive} class="nav-link">归档</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-10">
      <a href={links.home} class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-8">
        ← 返回首页
      </a>

      <h1 class="text-2xl font-bold text-gray-900 mb-8">{cat}</h1>

      {catArticles.length === 0 ? (
        <p class="text-sm text-gray-400">该分类暂无文章。</p>
      ) : (
        <div class="border-t border-gray-100">
          {catArticles.map(article => (
            <a
              href={links.article(article.id)}
              class="article-card group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="category-tag">{article.data.category}</span>
                <span class="read-time">{article.data.readTime}</span>
              </div>
              <h2 class="text-base font-semibold text-gray-800 group-hover:text-gray-600 transition-colors leading-snug mb-1">
                {article.data.title}
              </h2>
              <p class="text-sm text-gray-400">{article.data.date.toISOString().slice(0, 10)}</p>
            </a>
          ))}
        </div>
      )}
    </main>

    <footer class="border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-6 py-8 text-center">
        <p class="text-xs text-gray-400">© 2026 Wilfred · 保留所有权利</p>
      </div>
    </footer>

  </div>
</Layout>
