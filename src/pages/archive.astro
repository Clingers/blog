---
import Layout from '../layouts/Layout.astro';
import { articles } from '../data/articles';

const sorted = [...articles].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Group by year
const byYear = sorted.reduce((acc, article) => {
  const year = article.date.split('-')[0];
  if (!acc[year]) acc[year] = [];
  acc[year].push(article);
  return acc;
}, {} as Record<string, typeof articles>);

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="归档 — Wilfred's Blog" description="所有文章的归档页面。">
  <div class="min-h-screen bg-white">

    <header class="border-b border-gray-100">
      <div class="max-w-3xl mx-auto px-6 pt-6 pb-4">
        <div class="flex items-center justify-between">
          <h1 class="text-lg font-bold text-gray-900">
            <a href="/blog/" class="hover:text-gray-600 transition-colors">future/proof</a>
          </h1>
          <nav class="flex items-center gap-5">
            <a href="/blog/about" class="nav-link">关于</a>
            <a href="/blog/archive" class="nav-link font-semibold text-gray-900">归档</a>
            <a href="/blog/newsletter" class="nav-link">通讯</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-10">
      <a href="/blog/" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-8">
        ← 返回首页
      </a>

      <h1 class="text-2xl font-bold text-gray-900 mb-8">归档</h1>

      {years.map(year => (
        <section class="mb-10">
          <h2 class="section-heading mb-4">{year}</h2>
          <div class="border-t border-gray-100">
            {byYear[year].map(article => (
              <a
                href={`/blog/articles/${article.slug}`}
                class="flex items-start justify-between gap-4 py-4 border-b border-gray-50 hover:bg-gray-50 transition-colors group"
              >
                <div class="flex-1 min-w-0">
                  <span class="category-tag mr-3">{article.category}</span>
                  <span class="text-sm text-gray-800 group-hover:text-gray-600 transition-colors">
                    {article.title}
                  </span>
                </div>
                <span class="text-xs text-gray-400 flex-shrink-0 mt-0.5">{article.date}</span>
              </a>
            ))}
          </div>
        </section>
      ))}

    </main>

    <footer class="border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-6 py-8 text-center">
        <p class="text-xs text-gray-400">© 2026 Wilfred · 保留所有权利</p>
      </div>
    </footer>

  </div>
</Layout>
